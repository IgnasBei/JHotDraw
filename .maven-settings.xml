<?xml version="1.0" encoding="UTF-8"?>
<!--
JHotDraw — Maven settings used during CI on GitHub Actions.

This file authenticates Maven against the "github" repository declared in the
project root pom.xml (https://maven.pkg.github.com/sweat-tek/MavenRepository).
The credentials are read from the GitHub-Actions-provided GITHUB_ACTOR /
GITHUB_TOKEN environment variables — no personal access tokens are committed.

Reference:
  https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-apache-maven-registry
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
  </servers>

</settings>
